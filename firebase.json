{
  "hosting": {
    "public": "web",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "**/*.test.js"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true
    }
  }
}
