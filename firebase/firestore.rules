rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-account record: the name this person goes by and which pairing
    // they're in. It's what lets a second device (phone + desktop) find the
    // same pairing after signing in. Private to its owner; the couple doc's
    // rules below are still the only thing that grants access to a pairing,
    // so pointing coupleId at someone else's pairing gets you nothing.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['displayName', 'lastName', 'coupleId']) &&
        (!('displayName' in request.resource.data) ||
          (request.resource.data.displayName is string &&
           request.resource.data.displayName.size() <= 60)) &&
        // Shown to the partner when they confirm a pairing ("Pair with Alex Smith?").
        (!('lastName' in request.resource.data) ||
          (request.resource.data.lastName is string &&
           request.resource.data.lastName.size() <= 60)) &&
        (!('coupleId' in request.resource.data) ||
          request.resource.data.coupleId is string);
    }

    match /couples/{coupleId} {
      // Readable only by an existing participant, or by anyone (i.e. a
      // holder of the code) while it has a free place: that's how someone
      // joining sees whose pairing it is, and follows their request while
      // it waits for the creator's approval.
      allow get: if request.auth != null &&
        (request.auth.uid in resource.data.participantUIDs ||
         resource.data.participantUIDs.size() < 2);

      // No `list` is ever granted on this collection: codes can only
      // be looked up by exact ID, never browsed/enumerated.

      allow create: if request.auth != null &&
        request.resource.data.participantUIDs == [request.auth.uid] &&
        !('joinRequest' in request.resource.data);

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      function isParticipant() {
        return request.auth.uid in resource.data.participantUIDs;
      }
      function hasRequest() {
        return resource.data.get('joinRequest', null) != null;
      }
      function requestCleared() {
        return request.resource.data.get('joinRequest', null) == null;
      }

      // Pairing takes both people: someone with the code *asks* to join
      // (joinRequest, with their name), and only the creator's approval adds
      // them. Nobody can add themselves any more, and the creator can only
      // add the person who actually asked.
      allow update: if request.auth != null && (
        // 1. A participant's ordinary edit: anything except membership.
        //    A join request can only be removed this way (declined), never
        //    written, so a creator can't fake one to add someone who never
        //    asked. Cancelling (setting `closed`) is only for a pairing
        //    nobody has joined yet; otherwise a creator confirming "cancel"
        //    just as their partner joined would strand the partner.
        (isParticipant() &&
         !changed().hasAny(['participantUIDs']) &&
         (!changed().hasAny(['joinRequest']) || requestCleared()) &&
         (!changed().hasAny(['closed']) || resource.data.participantUIDs.size() < 2))
        ||
        // 2. Approving: the creator (the only participant so far) adds
        //    exactly the person who asked, with their name, and clears the
        //    request. Nothing else changes in the same write.
        (isParticipant() &&
         resource.data.participantUIDs.size() == 1 &&
         resource.data.get('closed', false) != true &&
         hasRequest() &&
         request.resource.data.participantUIDs ==
           resource.data.participantUIDs.concat([resource.data.joinRequest.uid]) &&
         requestCleared() &&
         changed().hasOnly(['participantUIDs', 'partnerProfiles', 'joinRequest']))
        ||
        // 3. Asking to join: someone with the code, not in it, while it has
        //    a free place, isn't cancelled (an old code mustn't pair you with
        //    someone who has moved on), and nobody else is already waiting.
        //    Only the request changes, and it's in the asker's own name.
        (!isParticipant() &&
         resource.data.participantUIDs.size() < 2 &&
         resource.data.get('closed', false) != true &&
         changed().hasOnly(['joinRequest']) &&
         request.resource.data.joinRequest.uid == request.auth.uid &&
         request.resource.data.joinRequest.keys()
           .hasOnly(['uid', 'displayName', 'lastName', 'timeZoneIdentifier', 'requestedAt']) &&
         request.resource.data.joinRequest.displayName is string &&
         request.resource.data.joinRequest.displayName.size() <= 60 &&
         (!('lastName' in request.resource.data.joinRequest) ||
           (request.resource.data.joinRequest.lastName is string &&
            request.resource.data.joinRequest.lastName.size() <= 60)) &&
         (!hasRequest() || resource.data.joinRequest.uid == request.auth.uid))
        ||
        // 4. Withdrawing your own request.
        (!isParticipant() &&
         hasRequest() &&
         resource.data.joinRequest.uid == request.auth.uid &&
         changed().hasOnly(['joinRequest']) &&
         requestCleared())
      );

      allow delete: if false; // no deletes in v1

      // Deliberately NOT `{sub=**}` (recursive wildcard): that can match
      // *zero* additional segments in Firestore Rules, meaning it also
      // matched the couples/{coupleId} document itself and silently
      // granted any participant unrestricted write access there:
      // completely bypassing the tamper guard in `allow update` above.
      // Found by the emulator test suite, not by inspection. Subcollections
      // (events, importantDates, pings) are all exactly one level deep, so
      // requiring a mandatory collection-name segment before the document
      // wildcard is sufficient and structurally can't match the parent.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in
            get(/databases/$(database)/documents/couples/$(coupleId)).data.participantUIDs;
      }
    }
  }
}
